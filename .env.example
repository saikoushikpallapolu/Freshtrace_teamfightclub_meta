# Application Environment Configuration Template

# Application Settings
APP_ENVIRONMENT=development
APP_LOG_LEVEL=INFO

# Local product API (explicit environment variables; this entry point does not load .env)
PRODUCT_DATABASE_URL=sqlite:///product_local.db
PRODUCT_MEDIA_ROOT=data/media/uploads
# Legacy combined API: optional explicit URL overrides AWS_RDS_* configuration
# DATABASE_URL=sqlite:///backend_local.db

# AWS Credentials (Paste your IAM User keys here)
AWS_ACCESS_KEY_ID=your_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_secret_access_key_here
AWS_REGION=ap-south-1
AWS_DEFAULT_REGION=ap-south-1

# AWS IoT Core Settings
AWS_IOT_ENDPOINT=your-endpoint.iot.ap-south-1.amazonaws.com
AWS_IOT_TOPIC=telemetry/device/Device-01/telemetry
AWS_IOT_CLIENT_ID=Device-01
