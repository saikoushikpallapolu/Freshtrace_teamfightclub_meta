# Copy to .env. Existing shell values take precedence. Never commit real keys.
# One Meta key serves SAM, Spark, Wonder, and voice validation scripts.
MODEL_API_KEY=
APP_ENVIRONMENT=development
APP_LOG_LEVEL=INFO
APP_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Visual workspace API (8080)
PRODUCT_DATABASE_URL=sqlite:///product_local.db
PRODUCT_MEDIA_ROOT=data/media/uploads

# Sensor API (8081): blank uses local SQLite, or complete AWS_RDS_* settings.
DATABASE_URL=

# Public browser overrides; blank uses local Vite proxies. No secrets here.
VITE_API_BASE=
VITE_DEVICE_API_BASE=

# Optional AWS cloud integration. IAM role credentials are also supported.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional for temporary STS credentials; leave blank for IAM-user keys/roles.
AWS_SESSION_TOKEN=
AWS_REGION=ap-south-1
AWS_DEFAULT_REGION=ap-south-1
AWS_IOT_ENDPOINT=
AWS_IOT_TOPIC=telemetry/device/Device-01/telemetry
AWS_IOT_CLIENT_ID=Device-01
AWS_SQS_QUEUE_URL=
AWS_SNS_TOPIC_ARN=
AWS_S3_BUCKET=
AWS_EC2_INSTANCE_ID=

# Optional RDS: endpoint and password must be set together.
AWS_RDS_IDENTIFIER=backend-db
AWS_RDS_ENDPOINT=
AWS_RDS_PORT=5432
AWS_RDS_USER=backendadmin
AWS_RDS_PASSWORD=
AWS_RDS_DBNAME=backend

# Required only by opt-in provisioning scripts; use reviewed trusted CIDRs.
AWS_ADMIN_CIDR=
AWS_RDS_ALLOWED_CIDR=
